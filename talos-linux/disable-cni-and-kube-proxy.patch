---
# yaml-language-server: $schema=https://talos.dev/v1.11/schemas/v1alpha1_config.schema.json

# This patch file:
#   * Tells Talos not to provision its default CNI (flannel) into the cluster
#   * Tells Talos not to install kube-proxy (for Cilium Agent replacement)

cluster:
  # For Cilium CNI: https://www.talos.dev/v1.11/kubernetes-guides/network/deploying-cilium/#machine-config-preparation
  network:
    cni:
      name: none
  proxy:
    disabled: true
